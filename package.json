{
  "name": "linear-stickman-explainer-skill",
  "version": "0.1.0",
  "description": "Linear issue to stickman comic-strip explainer pipeline.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "start": "node dist/server/server.js",
    "test:openai": "tsx src/tests/test-openai.ts",
    "test:linear": "tsx src/tests/test-linear.ts",
    "test:storyboard": "tsx src/tests/test-storyboard.ts",
    "test:images": "tsx src/tests/test-images.ts",
    "test:visual-mapping": "tsx src/tests/test-visual-mapping.ts",
    "test:full": "tsx src/tests/test-full.ts",
    "test:all": "npm run typecheck && npm run test:visual-mapping",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
